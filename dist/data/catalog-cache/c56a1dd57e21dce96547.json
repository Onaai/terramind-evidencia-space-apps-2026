,"CIT3804203616-ESDIS","CIT4076065689-ESDIS","CIT3804385304-ESDIS","CIT3804206093-ESDIS","CIT4106693794-ESDIS","CIT3803960835-ESDIS","CIT3804191572-ESDIS","CIT4106684574-ESDIS","CIT4321027140-ESDIS","CIT3804304553-ESDIS","CIT4076011191-ESDIS","CIT4106698689-ESDIS","CIT3804187287-ESDIS","CIT4248448612-ESDIS","CIT4248448597-ESDIS","CIT4076056069-ESDIS","CIT4321022218-ESDIS","CIT3857569112-ESDIS","CIT3804266331-ESDIS","CIT3804106750-ESDIS","CIT4076021826-ESDIS","CIT4076051397-ESDIS","CIT3804296458-ESDIS","CIT3857575393-ESDIS","CIT4076032647-ESDIS","CIT4076011742-ESDIS","CIT3804322307-ESDIS","CIT4076045742-ESDIS","CIT4076059023-ESDIS","CIT3804192485-ESDIS","CIT4106687032-ESDIS","CIT3804307516-ESDIS","CIT3804238589-ESDIS","CIT3804054019-ESDIS","CIT3804008116-ESDIS","CIT4106699821-ESDIS","CIT3804271961-ESDIS","CIT3804051932-ESDIS","CIT3803966141-ESDIS","CIT3963293578-ESDIS","CIT3803961907-ESDIS","CIT4076027080-ESDIS","CIT4248445665-ESDIS","CIT3963291605-ESDIS"]},"has_variables":true,"data_center":"LPCLOUD","short_name":"MOD13A2","organizations":["LP DAAC","NASA/GSFC/SED/ESD/TISL/MODAPS"],"title":"MODIS/Terra Vegetation Indices 16-Day L3 Global 1km SIN Grid V061","coordinate_system":"CARTESIAN","summary":"The MOD13A2 Version 6.1 product provides Vegetation Index (VI) values at a per pixel basis at 1 kilometer (km) spatial resolution. There are two primary vegetation layers. The first is the Normalized Difference Vegetation Index (NDVI), which is referred to as the continuity index to the existing National Oceanic and Atmospheric Administration-Advanced Very High Resolution Radiometer (NOAA-AVHRR) derived NDVI. The second vegetation layer is the Enhanced Vegetation Index (EVI), which has improved sensitivity over high biomass regions. The algorithm for this product chooses the best available pixel value from all the acquisitions from the 16 day period. The criteria used is low clouds, low view angle and the highest NDVI/EVI value. \n\nProvided along with the vegetation layers and the two quality assurance (QA) layers are reflectance bands 1 (red), 2 (near-infrared), 3 (blue), and 7 (mid-infrared), as well as four observation layers. \n\nKnown Issues\n* For complete information about known issues please refer to the [MODIS/VIIRS Land Quality Assessment website](https://landweb.modaps.eosdis.nasa.gov/knownissue?sensor=MODIS&sat=Terra&as=61).","service_features":{"opendap":{"has_formats":false,"has_variables":false,"has_transforms":false,"has_combine":false,"has_spatial_subsetting":false,"has_temporal_subsetting":false},"esi":{"has_formats":false,"has_variables":false,"has_transforms":false,"has_combine":false,"has_spatial_subsetting":false,"has_temporal_subsetting":false},"harmony":{"has_formats":false,"has_variables":false,"has_transforms":false,"has_combine":false,"has_spatial_subsetting":false,"has_temporal_subsetting":false}},"orbit_parameters":{},"id":"C2565788905-LPCLOUD","has_formats":false,"consortiums":["GEOSS","EOSDIS"],"original_format":"UMM_JSON","collection_data_type":"SCIENCE_QUALITY","archive_center":"LP DAAC","has_temporal_subsetting":false,"browse_flag":true,"platforms":["Terra"],"association_details":{"variables":[{"concept_id":"V3142301617-LPCLOUD"},{"concept_id":"V3142301239-LPCLOUD"},{"concept_id":"V3142301467-LPCLOUD"},{"concept_id":"V3142303002-LPCLOUD"},{"concept_id":"V3142301054-LPCLOUD"},{"concept_id":"V3142301704-LPCLOUD"},{"concept_id":"V3142301508-LPCLOUD"},{"concept_id":"V3142301830-LPCLOUD"},{"concept_id":"V3142301389-LPCLOUD"},{"concept_id":"V3142301872-LPCLOUD"},{"concept_id":"V3142301745-LPCLOUD"},{"concept_id":"V3142301578-LPCLOUD"}],"tools":[{"concept_id":"TL1860232272-LPDAAC_ECS"}],"citations":[{"concept_id":"CIT4106706895-ESDIS"},{"concept_id":"CIT3804001890-ESDIS"},{"concept_id":"CIT3804217439-ESDIS"},{"concept_id":"CIT3804259413-ESDIS"},{"concept_id":"CIT4076010296-ESDIS"},{"concept_id":"CIT3804180041-ESDIS"},{"concept_id":"CIT4106700240-ESDIS"},{"concept_id":"CIT3857562139-ESDIS"},{"concept_id":"